# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of this app (used for auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Market prices (Phase 6). All server-only: never prefix with NEXT_PUBLIC_.
# Service role key (Project Settings -> API). It bypasses RLS and is used only
# to store fetched prices. Required for the "update prices" button and cron.
SUPABASE_SERVICE_ROLE_KEY=

# Protects GET /api/cron/prices. Use a long random string
# (e.g. `openssl rand -hex 32`). The route stays closed while this is empty.
CRON_SECRET=

# Optional. Price source (default "yahoo"); see lib/prices/index.ts.
# PRICE_PROVIDER=yahoo
# Optional. Override the Yahoo base URL (used by tests).
# YAHOO_BASE_URL=
